# otp-email-service — variables d'environnement
# Copier ce fichier en .env et remplir avec les vraies valeurs.
# NE JAMAIS commiter .env dans Git.

# Service
APP_NAME=otp-email-service
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Sécurité service-à-service
API_KEY=change_me_to_a_64_char_random_hex_string_change_me_to_a_64_char
HMAC_SECRET=change_me_to_a_very_long_random_secret_for_hmac_signatures
ADMIN_API_KEY=change_me_to_a_64_char_random_hex_string_for_admin_routes_xx

# Redis
REDIS_URL=redis://redis:6379/0
USE_FAKEREDIS=false

# Port exposé sur l'hôte (docker-compose)
APP_PORT=8000

# Email
EMAIL_PROVIDER=gmail
FROM_EMAIL=no-reply@sendbid.example.com
FROM_NAME=SendBID

# Gmail SMTP (compte existant du projet)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sendbid@gmail.com
SMTP_PASSWORD=app_password_gmail

# Brevo / Resend (optionnel, non implémenté mais prêt)
BREVO_API_KEY=change_me
RESEND_API_KEY=change_me

# Routage pays et rollout
RISKY_COUNTRIES=CN,RU,BY,IR,KP
ROLLOUT_PERCENTAGE=100

# Rate limiting
MAX_SENDS_PER_USER_PER_10MIN=3
MAX_SENDS_PER_IP_PER_10MIN=3
COOLDOWN_SECONDS=60
MAX_VERIFY_ATTEMPTS=5
OTP_TTL_SECONDS=300
