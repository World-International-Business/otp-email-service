# otp-email-service — variables d'environnement
# Copier ce fichier en .env et remplir avec les vraies valeurs.
# NE JAMAIS commiter .env dans Git.

# Service
APP_NAME=otp-email-service
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# URL publique du service (https) — magic links OTP, header HSTS,
# et whitelist same-origin. OBLIGATOIRE en production.
PUBLIC_BASE_URL=https://api.aiforge.world

# Sécurité service-à-service
API_KEY=change_me_to_a_64_char_random_hex_string_change_me_to_a_64_char
HMAC_SECRET=change_me_to_a_very_long_random_secret_for_hmac_signatures
ADMIN_API_KEY=change_me_to_a_64_char_random_hex_string_for_admin_routes_xx
# Mot de passe mémorisable pour se connecter à /admin (alternative à ADMIN_API_KEY)
ADMIN_WEB_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
USE_FAKEREDIS=false

# Port exposé sur l'hôte (docker-compose)
APP_PORT=8000

# Console de démo /demo — endpoints NON authentifiés, local uniquement
DEMO_ENABLED=false
# Désactiver l'inscription publique (false = /register fermé)
WEB_SIGNUP_ENABLED=true

# Email
EMAIL_PROVIDER=gmail
FROM_EMAIL=no-reply@sendbid.example.com
FROM_NAME=SendBID

# Gmail SMTP (compte existant du projet)
# SMTP_PASSWORD = mot de passe d'application Google (16 car.) — PAS le mot de
# passe normal : myaccount.google.com > Sécurité > Mots de passe des applications
# (2FA requise). Guide complet : docs/08-emails-reels.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sendbid@gmail.com
SMTP_PASSWORD=app_password_gmail
# Vide = auto (SSL si port 465, STARTTLS sinon) · true = SSL implicite · false = jamais SSL
SMTP_USE_SSL=
# SMTP_USE_SSL : laisser vide = auto (SSL si port 465, STARTTLS sinon).
# Adresses pro : OVH ssl0.ovh.net:465, Zoho smtp.zoho.com:465,
# IONOS smtp.ionos.com:587, ou mailserver/ auto-hébergé.
# EMAIL_PROVIDER=smtp fonctionne aussi (alias explicite de gmail).
#SMTP_USE_SSL=

# Brevo / Resend (optionnel — requis si EMAIL_PROVIDER=brevo|resend)
BREVO_API_KEY=change_me
RESEND_API_KEY=change_me

# ===================== Paiements (optionnel — vides = validation manuelle admin) =====
# Stripe — dashboard.stripe.com -> Developers -> API keys + Webhooks
STRIPE_SECRET_KEY=            # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (endpoint : /v1/billing/webhooks/stripe)
STRIPE_PRICE_PRO=             # price_... abonnement Pro
STRIPE_PRICE_ENTERPRISE=      # price_... abonnement Enterprise
# PayPal — developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # webhook : /v1/billing/webhooks/paypal
PAYPAL_ENV=sandbox            # sandbox | live
# Mobile money — Orange Money (developer.orange.com, Orange Money Web Payment)
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_MERCHANT_SECRET=
# Mobile money — MTN MoMo (momodeveloper.mtn.com, Collection API)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
# Agrégateur mobile money — CinetPay (cinetpay.com : Orange Money, MTN MoMo,
# Wave, Moov… couvre l'Afrique de l'Ouest/Centrale en une seule intégration)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=             # notify_url : /v1/billing/webhooks/cinetpay

# Tarifs facturés en ligne (0 ou vide = bouton masqué, validation manuelle seule)
# Carte / PayPal — devise BILLING_CURRENCY
PLAN_PRICE_PRO=0
PLAN_PRICE_ENTERPRISE=0
BILLING_CURRENCY=EUR
# Agrégateur mobile — devise BILLING_CURRENCY_MOBILE (montant entier, ex. 5000 XOF)
PLAN_PRICE_PRO_MOBILE=0
PLAN_PRICE_ENTERPRISE_MOBILE=0
BILLING_CURRENCY_MOBILE=XOF

# Routage pays et rollout
RISKY_COUNTRIES=CN,RU,BY,IR,KP
ROLLOUT_PERCENTAGE=100

# Rate limiting
MAX_SENDS_PER_USER_PER_10MIN=3
MAX_SENDS_PER_IP_PER_10MIN=3
COOLDOWN_SECONDS=60
MAX_VERIFY_ATTEMPTS=5
OTP_TTL_SECONDS=300

# Scalabilité & automatisation
# Nombre de workers uvicorn (processus parallèles ; ~1-2 par CPU, défaut 2)
WEB_CONCURRENCY=2
# Intervalle (s) du balayage qui rétrograde en plan gratuit les abonnements expirés
BILLING_CHECK_INTERVAL_SECONDS=3600
