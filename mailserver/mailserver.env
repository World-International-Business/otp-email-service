# --- Identité du serveur ---
OVERRIDE_HOSTNAME=mail.aiforge.world

# --- TLS via Let's Encrypt (certbot sur l'hôte) ---
SSL_TYPE=letsencrypt
SSL_CERT_PATH=/etc/letsencrypt/live/mail.aiforge.world/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mail.aiforge.world/privkey.pem

# --- Sécurité ---
ENABLE_FAIL2BAN=1
ENABLE_CLAMAV=0          # mettre 1 si VPS >= 4 Go RAM
ENABLE_SPAMASSASSIN=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# --- Comportement ---
ENABLE_POP3=0
ENABLE_IMAP=1
SMTP_ONLY=0
PERMIT_DOCKER=network
SPOOF_PROTECTION=1
ENABLE_SRS=1

# Ne pas envoyer de rapport quarantaine aux expéditeurs
ENABLE_QUARANTINE=1

LOG_LEVEL=info
